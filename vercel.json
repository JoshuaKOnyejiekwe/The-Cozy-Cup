{
  "version": 2,
  "builds": [
    { "src": "*.php", "use": "vercel-php@0.7.2" },
    { "src": "menu", "use": "vercel-php@0.7.2" }
  ],
  "routes": [
    {
      "src": "/(.*\\.css)",
      "headers": { "Content-Type": "text/css; charset=utf-8" },
      "dest": "/$1"
    },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
