{
  "version": 2,
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "menu": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/(.*\\.css)",
      "headers": { "Content-Type": "text/css; charset=utf-8" },
      "dest": "/$1"
    },
    { "src": "/(.*\\.php)", "dest": "/$1" },
    { "src": "/menu", "dest": "/menu" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
